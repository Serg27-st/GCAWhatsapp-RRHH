@implements IDisposable
@inject SesionAnalista Sesion
@inject ClienteApi Api

<div class="nav-lateral">
    <div class="marca">
        <span class="logo">RRHH</span>
        <span class="sub">WhatsApp</span>
    </div>

    <nav>
        <NavLink href="/bandeja" Match="NavLinkMatch.All">Bandeja</NavLink>
        <NavLink href="/vacantes">Vacantes</NavLink>

        @* Lo que cada rol puede ver y administrar (V23). La Api lo exige igual; ocultarlo solo
           evita ofrecer una pantalla que va a responder que no. *@
        @if (Sesion.VeMetricas)
        {
            <NavLink href="/metricas">Métricas</NavLink>
        }

        @if (Sesion.PuedeAdministrarEquipo)
        {
            <NavLink href="/equipo">Equipo</NavLink>
        }

        @if (Sesion.EsSistemas)
        {
            @* FUN-15: el contador es lo que hace que alguien entre a mirar. Sin él, una plantilla sin
               aprobar o una vacante sin formulario esperan a que a alguien se le ocurra revisar. *@
            <NavLink href="/configuracion">
                Configuración
                @if (_alertas > 0)
                {
                    <span class="contador-alertas" title="Alertas operativas abiertas">@_alertas</span>
                }
            </NavLink>
        }

        @if (Sesion.Activa)
        {
            <NavLink href="/mi-cuenta">Mi cuenta</NavLink>
        }
    </nav>
</div>

@code {
    private int _alertas;

    protected override void OnInitialized() => Sesion.Cambio += AlCambiarSesion;

    protected override Task OnParametersSetAsync() => ContarAlertasAsync();

    private void AlCambiarSesion()
    {
        InvokeAsync(StateHasChanged);

        // Al entrar con una sesión nueva se vuelve a contar: quien administra tiene que verlo apenas entra.
        InvokeAsync(ContarAlertasAsync);
    }

    private async Task ContarAlertasAsync()
    {
        if (!Sesion.EsSistemas)
        {
            _alertas = 0;
            return;
        }

        _alertas = (await Api.AlertasAsync()).Count;

        StateHasChanged();
    }

    public void Dispose() => Sesion.Cambio -= AlCambiarSesion;
}
