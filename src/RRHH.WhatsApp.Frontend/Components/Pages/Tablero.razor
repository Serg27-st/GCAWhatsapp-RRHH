@page "/tablero/{HcId:int}"
@rendermode InteractiveServer
@inject ClienteApi Api
@inject SesionAnalista Sesion

<PageTitle>Tablero</PageTitle>

@* Regla 13: columnas arrastrables. Se usa el drag nativo del navegador y no una libreria: alcanza
   para mover una tarjeta y evita sumar JavaScript al proyecto. *@
<div class="tablero">
    <header>
        <h1>@(_tablero?.Vacante ?? $"Vacante {HcId}")</h1>

        @if (_error is { } error)
        {
            <p class="error">@error</p>
        }
    </header>

    @if (_tablero is null)
    {
        @* Nulo despues de cargar es un rechazo de la Api: la vacante no existe, no es de las cuentas
           de quien la pide (Regla 4), o la Api no respondio. Sin distinguirlo, la pantalla diria
           "Cargando" para siempre. *@
        <p class="vacio">
            @(_cargado
                ? "No se pudo abrir este tablero: no existe, no es de tus cuentas o la Api no respondió."
                : "Cargando el tablero…")
        </p>
    }
    else
    {
        @* FUN-10 (A11): soltar en la columna de descarte despide al postulante. Se confirma aparte
           porque el arrastre es fácil de hacer sin querer, y el mensaje no se puede deshacer. *@
        @if (_descarte is { } descarte)
        {
            <div class="dialogo">
                <h4>¿Descartar a @(descarte.Tarjeta.NombrePostulante ?? "este postulante")?</h4>

                <label class="urgente">
                    <input type="checkbox" @bind="_enviarCierre" />
                    Enviar mensaje de cierre al postulante
                </label>

                <div class="dialogo-acciones">
                    <button class="btn btn-danger" @onclick="ConfirmarDescarte">Descartar</button>
                    <button class="btn btn-link" @onclick="() => _descarte = null">Cancelar</button>
                </div>
            </div>
        }

        <div class="columnas">
            @foreach (var etapa in _tablero.Etapas.OrderBy(e => e.Orden))
            {
                <section class="columna @(_destino == etapa.EtapaId ? "destino" : "")"
                         @ondragover:preventDefault="true"
                         @ondragenter="() => _destino = etapa.EtapaId"
                         @ondragleave="() => _destino = null"
                         @ondrop="() => Soltar(etapa.EtapaId)">

                    <h2>@etapa.Nombre <span class="cantidad">@etapa.Postulaciones.Count</span></h2>

                    @foreach (var tarjeta in etapa.Postulaciones)
                    {
                        <article class="tarjeta" draggable="true" @ondragstart="() => _arrastrada = tarjeta">
                            <strong>@(tarjeta.NombrePostulante ?? $"Postulante {tarjeta.PostulanteId}")</strong>

                            @if (tarjeta.Dni is { } dni)
                            {
                                <span class="dni">DNI @dni</span>
                            }

                            <span class="estado">@tarjeta.Estado</span>

                            @* FUN-08 (A2): un descarte que el analista reconsidera, o un ex trabajador
                               que vuelve, es un proceso vivo otra vez y sale de la columna final. *@
                            @if (tarjeta.Estado == EstadosPostulacion.Descartado)
                            {
                                <button class="btn btn-link" @onclick="() => Reingreso(tarjeta)">Reingreso</button>
                            }
                        </article>
                    }
                </section>
            }
        </div>
    }
</div>

@code {
    [Parameter] public int HcId { get; set; }

    private TableroKanban? _tablero;
    private PostulacionResumen? _arrastrada;

    /// <summary>FUN-10: el descarte que espera confirmacion, con la casilla del cierre marcada por defecto.</summary>
    private (PostulacionResumen Tarjeta, int EtapaId)? _descarte;
    private bool _enviarCierre = true;
    private int? _destino;
    private string? _error;
    private bool _cargado;

    protected override Task OnParametersSetAsync() => Cargar();

    /// <summary>FUN-08 (A2): devuelve la postulación a un proceso vivo y refresca el tablero.</summary>
    private async Task Reingreso(PostulacionResumen tarjeta)
    {
        _error = null;

        var respuesta = await Api.MarcarReingresoAsync(tarjeta.PostulacionId);

        if (!respuesta.Exito)
        {
            _error = respuesta.Motivo ?? "No se pudo marcar el reingreso.";
            return;
        }

        await Cargar();
    }

    private async Task Cargar()
    {
        _tablero = await Api.TableroAsync(HcId);
        _cargado = true;
        _destino = null;
    }

    private async Task Soltar(int etapaId)
    {
        _destino = null;

        if (_arrastrada is not { } tarjeta)
            return;

        if (Sesion.AnalistaId is not { } analistaId)
        {
            _error = "Elegí un analista antes de mover tarjetas.";
            _arrastrada = null;
            return;
        }

        // Soltar en la misma columna no es un movimiento: evita una auditoria vacia por arrastre.
        if (tarjeta.EtapaKanbanId == etapaId)
        {
            _arrastrada = null;
            return;
        }

        _error = null;
        _arrastrada = null;

        // FUN-10: la columna de descarte pide confirmacion con la casilla del cierre. Se reconoce por
        // su desenlace y no por el nombre, que se puede cambiar en la administracion (COR-11).
        var destino = _tablero?.Etapas.FirstOrDefault(e => e.EtapaId == etapaId);

        if (destino?.EstadoResultante == EstadosPostulacion.Descartado)
        {
            _descarte = (tarjeta, etapaId);
            _enviarCierre = true;
            return;
        }

        await MoverAsync(tarjeta, etapaId, enviarCierre: true);
    }

    private async Task ConfirmarDescarte()
    {
        if (_descarte is not { } descarte)
            return;

        _descarte = null;

        await MoverAsync(descarte.Tarjeta, descarte.EtapaId, _enviarCierre);
    }

    private async Task MoverAsync(PostulacionResumen tarjeta, int etapaId, bool enviarCierre)
    {
        // Lo que se mueve es la postulacion, y va por su propia ruta (V22 de docs/decisiones.md).
        var respuesta = await Api.MoverEtapaAsync(
            tarjeta.PostulacionId, new PeticionMoverEtapa(etapaId, enviarCierre));

        if (!respuesta.Exito)
            _error = respuesta.Motivo;

        await Cargar();
    }
}
